# TURN 릴레이 설정 (LTE/5G 등 대칭형 NAT 환경 연결용, 선택 사항)
# 로컬 개발: 이 파일을 .env.local로 복사 후 값 입력 / 배포: GitHub 저장소 Secrets에 같은 이름으로 등록
# 주의: VITE_ 값은 빌드 결과물(JS)에 그대로 포함되어 공개됩니다.

# 방법 1) RTCIceServer[] JSON을 반환하는 자격 증명 API (예: Metered)
# VITE_TURN_CREDENTIALS_URL=https://<앱이름>.metered.live/api/v1/turn/credentials?apiKey=<API_KEY>

# 방법 2) 고정 TURN 서버 정보 (URL은 쉼표로 구분)
# VITE_TURN_URLS=turn:example.com:3478?transport=udp,turns:example.com:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
